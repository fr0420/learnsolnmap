#!/bin/bash 

PROBLEM=fpu
T_INIT=0.
T_END=400.
N=200
NFINE=$((2**17))
METHOD=McAte5
DATADIR=../data/fpu/omega300/rhmc-H0/css4_dt4e-1_h5e-6_Nchains100_Njumps2000_sigma1e-1/ma5_Dt2e0_h1.5259e-5
OMEGA=300.

julia targets.jl $PROBLEM $T_INIT $T_END $N $DATADIR --Nf $NFINE -f $METHOD --fpu_omega $OMEGA --use_float64x4
